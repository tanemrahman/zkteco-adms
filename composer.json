{
    "name": "tanemrahman/zkteco-adms",
    "version": "1.0.0",
    "description": "ZKTeco ADMS / iClock Push protocol server for Laravel — devices push attendance directly to your app.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tanem Rahman",
            "email": "tanem@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "TanemRahman\\ZktecoAdms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TanemRahman\\ZktecoAdms\\Providers\\ZktecoAdmsServiceProvider"
            ],
            "aliases": {
                "ZktecoAdms": "TanemRahman\\ZktecoAdms\\ZktecoAdms"
            }
        }
    },
    "minimum-stability": "stable"
}
