{
    "name": "tanemrahman/zkteco-adms",
    "version": "1.4.1",
    "description": "Production-ready ZKTeco ADMS / iClock Push protocol server for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["zkteco", "adms", "iclock", "biometric", "attendance", "laravel", "push"],
    "authors": [
        {
            "name": "Tanem Rahman",
            "email": "tanemrah18@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TanemRahman\\ZktecoAdms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TanemRahman\\ZktecoAdms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TanemRahman\\ZktecoAdms\\ZktecoAdmsServiceProvider"
            ],
            "aliases": {
                "ZktecoAdms": "TanemRahman\\ZktecoAdms\\Facades\\ZktecoAdms"
            }
        },
        "branch-alias": {
            "dev-main": "1.4.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
